function [new_pose] = predict_pose(old_pose, motion_vector, read_only_vars)
%PREDICT_POSE Summary of this function goes here

if(motion_vector(1) ~= motion_vector(2))
    R = read_only_vars.agent_drive.interwheel_dist/2*(motion_vector(1)+motion_vector(2))/(motion_vector(1)-motion_vector(2));
else
    R = 0;
end

omega = (motion_vector(1)-motion_vector(2))/ read_only_vars.agent_drive.interwheel_dist;
ICC = [old_pose(1) - R*sin(old_pose(3)), old_pose(2) + R*cos(old_pose(3))];
Ts = read_only_vars.sampling_period;

mu = 0; 
sigma = 0.02;    
prediction_noise = mu + sigma * randn(1, 3);

new_pose = [cos(omega*Ts) -sin(omega*Ts) 0; sin(omega*Ts) cos(omega*Ts) 0; 0 0 1]*[old_pose(1)-ICC(1); old_pose(2)-ICC(2); old_pose(3)]+[ICC(1); ICC(2); omega*Ts];
new_pose = new_pose + prediction_noise';

if new_pose(1) < read_only_vars  

end

