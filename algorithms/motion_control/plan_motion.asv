function [public_vars] = plan_motion(read_only_vars, public_vars)
%PLAN_MOTION Summary of this function goes here

% I. Pick navigation target

target = get_target(public_vars.estimated_pose, public_vars.path);


% II. Compute motion vector

if(0) %For manual sensorless
    if(read_only_vars.counter < 120)
        public_vars.motion_vector = [0.5, 0.5];
    elseif(read_only_vars.counter < 280)
        public_vars.motion_vector = [0.4, 0.44];
    elseif(read_only_vars.counter < 390)
        public_vars.motion_vector = [0.5, 0.5];
    elseif(read_only_vars.counter < 483)
        public_vars.motion_vector = [0.46, 0.4];
    elseif(read_only_vars.counter < 800)
        public_vars.motion_vector = [0.5, 0.5];
    else
        public_vars.motion_vector = [0, 0];
    end
else
    public_vars.motion_vector = [0.5, 0.5];
end