function [target] = get_target(estimated_pose, path)
%GET_TARGET Summary of this function goes here

persistent waypoint_not_cleared

if isempty(waypoint_not_cleared)
    waypoint_not_cleared = ones(size(path));
end

if norm(estimated_pose(1:2) - path(1,:)) < 0.1
    [] = find(waypoint_not_cleared, 1, "first")
end

used_path = path(waypoint_not_cleared);

target = used_path(1,:);

end

